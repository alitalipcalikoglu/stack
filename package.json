{
  "name": "@atc-web/stack",
  "version": "1.1.0",
  "private": true,
  "description": "Set up, wire and run every atc-web service with the console in one command: dependencies, secrets, API keys, env files, gateway routes, console services.json, first admin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/stack.git"
  },
  "type": "module",
  "bin": {
    "atc-stack": "bin/stack.js",
    "stack": "bin/stack.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node bin/stack.js setup",
    "up": "node bin/stack.js up",
    "dev": "node bin/stack.js dev",
    "down": "node bin/stack.js down",
    "status": "node bin/stack.js status",
    "backup": "node bin/stack.js backup",
    "restore": "node bin/stack.js restore",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "openapi:validate": "node openapi-validation/validate.mjs",
    "openapi:info-parity": "node openapi-validation/check-info-parity.mjs",
    "clients:generate": "node clients/typescript/generate.mjs",
    "clients:check": "node clients/typescript/check.mjs",
    "clients:typecheck": "clients/typescript/node_modules/.bin/tsc -p clients/typescript/tsconfig.json",
    "clients:test": "node --disable-warning=ExperimentalWarning --test \"clients/typescript/test/**/*.test.js\"",
    "clients:smoke": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"clients/typescript/test/smoke/*.test.ts\"",
    "mcp:typecheck": "mcp/node_modules/.bin/tsc -p mcp/jsconfig.json",
    "mcp:test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"mcp/test/*.test.mjs\"",
    "mcp:e2e": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"mcp/test/e2e/*.test.mjs\"",
    "mcp:catalog": "node mcp/tool-catalog.generate.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types mcp/tool-catalog.reconcile.mjs",
    "contracts:check": "npm run openapi:validate && npm run openapi:info-parity && npm run clients:check && npm run clients:typecheck && npm run clients:test && npm run mcp:typecheck && npm run mcp:test"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "yaml": "^2.9.1"
  }
}
